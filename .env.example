# Configure model IDs available to your accounts; there are no implicit model defaults.
LLM_PROVIDER_ORDER=vertex,groq,aistudio
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
VERTEX_MODEL=
# Vertex uses Application Default Credentials; never put credential JSON in this repository.
# Optional GOOGLE_APPLICATION_CREDENTIALS points to an external credential/config file.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
AISTUDIO_MODEL=
LLM_PROVIDER_TIMEOUT_SECONDS=6
PORT=8000
